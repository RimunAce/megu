{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MEGU",
  "version": "0.1.2",
  "identifier": "com.megu.app",
  "mainBinaryName": "MEGU",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MEGU",
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREMjI3OEI4NTlFMzc2QUUKUldTdWR1Tlp1SGdpM1NRRTJkYTlTRXYzOGtlcEp4eEpXL0wydW16eXV5eHRLRDYwcnFacVVPMWcK",
      "endpoints": ["https://github.com/RimunAce/megu/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "MEGU contributors",
    "copyright": "Copyright (c) 2026 MEGU contributors. MIT licensed.",
    "shortDescription": "Anime discovery and AniList sync for Windows",
    "longDescription": "MEGU is a fast Windows anime app: browse the AniList catalogue, keep your list in sync offline, follow the airing schedule and continue watching where you left off.",
    "category": "Entertainment",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
