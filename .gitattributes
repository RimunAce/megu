# Normalise text files, keep binaries untouched.
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.exe   binary
*.msi   binary
*.db    binary

# Generated files that are useful to review but noisy in diffs
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
